---
// Client-driven pagination: the page owning the list dispatches
//   pagination:update  { current, last }   →  this nav re-renders
// and listens for
//   pagination:go      { page }            ←  a button was clicked
---

<nav data-pagination aria-label="Pagination" class="flex flex-wrap items-center justify-center gap-[6px]" hidden></nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-pagination]');

  // Always first + last, up to three around the current page, "…" for gaps of two or more
  function windowed(current: number, last: number): (number | '…')[] {
    const pages = new Set([1, last, current - 1, current, current + 1].filter(p => p >= 1 && p <= last));
    const sorted = [...pages].sort((a, b) => a - b);
    const out: (number | '…')[] = [];
    sorted.forEach((p, i) => {
      const prev = sorted[i - 1];
      if (prev !== undefined) {
        if (p - prev === 2) out.push(prev + 1);
        else if (p - prev > 2) out.push('…');
      }
      out.push(p);
    });
    return out;
  }

  function item(label: string, opts: { page?: number; current?: boolean; disabled?: boolean; aria: string }) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'page-item' + (opts.current ? ' page-active' : '');
    btn.textContent = label;
    btn.setAttribute('aria-label', opts.aria);
    if (opts.current) btn.setAttribute('aria-current', 'page');
    if (opts.disabled) {
      btn.disabled = true;
    } else if (opts.page !== undefined) {
      const page = opts.page;
      btn.addEventListener('click', () => nav?.dispatchEvent(new CustomEvent('pagination:go', { detail: { page }, bubbles: true })));
    }
    return btn;
  }

  nav?.addEventListener('pagination:update', (e: Event) => {
    const { current, last } = (e as CustomEvent<{ current: number; last: number }>).detail;
    nav.replaceChildren();
    nav.hidden = last <= 1;
    if (last <= 1) return;

    nav.append(item('←', { page: current - 1, disabled: current <= 1, aria: 'Previous page' }));
    windowed(current, last).forEach(p => {
      if (p === '…') {
        const gap = document.createElement('span');
        gap.className = 'page-ellipsis';
        gap.setAttribute('aria-hidden', 'true');
        gap.textContent = '…';
        nav.append(gap);
      } else {
        nav.append(item(String(p), { page: p, current: p === current, aria: `Page ${p}` }));
      }
    });
    nav.append(item('→', { page: current + 1, disabled: current >= last, aria: 'Next page' }));
  });
</script>

<style is:global>
  [data-pagination] .page-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    padding: 9px 12px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-title);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }
  [data-pagination] .page-item:hover:not(:disabled):not(.page-active) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  [data-pagination] .page-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    cursor: default;
  }
  [data-pagination] .page-item:disabled {
    opacity: 0.4;
    cursor: default;
  }
  [data-pagination] .page-ellipsis {
    padding: 9px 4px;
    font-size: 14px;
    color: var(--color-muted);
    user-select: none;
  }
</style>
