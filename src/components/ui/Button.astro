---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'btn-accent inline-flex items-center gap-1 rounded-button bg-accent font-display font-semibold text-bg transition-colors',
    className,
  ]}
>
  <slot />
</a>

<style>
  .btn-accent:hover {
    background-color: var(--color-accent-dark);
  }
</style>
