---
import Badge from '../ui/Badge.astro';
import SectionHeader from '../ui/SectionHeader.astro';

const levels = [
  {
    level: 'A1',
    title: 'Build your foundation',
    tagline: 'Start from zero, build something real.',
    description:
      'Full grammar video lessons from scratch, giving you the toolkit to navigate the language. First sentences in context — grammar points brought to life immediately.',
    outcome: 'You can build your own sentences instead of reciting them.',
  },
  {
    level: 'A2',
    title: 'Bridge the gap',
    tagline: 'Keep building — and start crossing over.',
    description:
      'Grammar lessons to consolidate your foundation, paired with first immersion texts and comprehension exercises. The shift begins here.',
    outcome: 'You read a short real French text and follow the thread.',
  },
  {
    level: 'B1',
    title: 'Build your immersion habit',
    tagline: 'Stop studying French. Start understanding it.',
    description:
      '100% immersion content — everyday French at natural speed, with grammar focus woven into comprehensible material. This is where things start to click.',
    outcome: 'You follow a 30-minute podcast without the transcript.',
  },
  {
    level: 'B2',
    title: 'Go beyond the basics',
    tagline: 'Expand your world.',
    description:
      'Deep dives into specific topics — culture, politics, sports, history. Vocabulary islands (new thematic territory). Live book readings (Le Petit Prince and others). Advanced natural content.',
    outcome: 'You read a novel and hold a conversation about it.',
  },
] as const;

// Shared by the header row and every level row (desktop)
const columns = 'lg:grid-cols-[90px_250px_minmax(0,1fr)_280px] lg:gap-x-8';
---

<section id="levels" class="mx-auto max-w-[1180px] scroll-mt-24 px-6 pb-28 md:px-12">
  <SectionHeader eyebrow="Levels" headingLight="What you do," headingBold="and what you can do after" />

  <div role="table" aria-label="The four levels">
    <!-- Column headings (desktop only; on small screens each row labels itself) -->
    <div role="row" data-reveal class:list={['hidden border-b border-border pb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] lg:grid', columns]}>
      <span role="columnheader" class="text-muted">Level</span>
      <span role="columnheader" class="text-muted">Stage</span>
      <span role="columnheader" class="text-muted">What you do</span>
      <span role="columnheader" class="text-accent">By the end</span>
    </div>

    {levels.map(item => (
      <div
        role="row"
        data-reveal
        class:list={['grid grid-cols-1 gap-y-4 border-b border-border py-7 last:border-b-0', columns]}
      >
        <div role="cell">
          <Badge level={item.level} size="lg" />
        </div>

        <div role="cell">
          <h3 class="font-display text-2xl font-bold leading-[1.2] tracking-[-0.02em] text-title">{item.title}</h3>
          <p class="mt-1.5 text-[15px] italic leading-[1.5] text-muted">{item.tagline}</p>
        </div>

        <p role="cell" class="text-base leading-[1.65] text-body">{item.description}</p>

        <div role="cell" class="border-l-[3px] border-accent pl-4">
          <p class="mb-1 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-accent lg:hidden">By the end</p>
          <p class="text-[17px] font-medium leading-[1.45] text-title">{item.outcome}</p>
        </div>
      </div>
    ))}
  </div>
</section>
