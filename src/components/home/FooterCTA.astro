---
import Button from '../ui/Button.astro';
---

<section class="mx-auto max-w-[840px] px-6 pb-20 pt-4 text-center md:px-12 md:pb-28">
  <h2 data-reveal class="mb-5 font-display text-3xl tracking-[-0.03em] text-title md:text-4xl">
    <span style="font-weight: var(--weight-light)">Ready to</span>
    <span style="font-weight: var(--weight-bold)"> cross the threshold?</span>
  </h2>
  <p data-reveal class="mx-auto mb-8 max-w-[480px] text-base leading-[1.65] text-muted md:text-[17px]">
    Start with free content. No credit card. No pressure. Just French.
  </p>
  <div data-reveal>
    <Button href="/start/" class="px-8 py-[15px] text-base">Start your free trial →</Button>
  </div>
</section>
