---
import SectionHeader from '../ui/SectionHeader.astro';

// Feature switcher: 3 steps, all shown at once (active = highlighted, rest = greyed out).
// No animation library — the crossfade runs on plain CSS transitions.
// Cards are switched by click or by scroll: wheel scroll steps through the cards locally,
// and scrolling past the first/last card lets the event fall through to the page-level
// section magnet (see SectionDots.astro). Below lg, the switcher is hidden and the cards are
// simply stacked.
const steps = [
  {
    label: 'Learn',
    title: 'Build Your Foundation',
    subtitle: 'Master real French grammar, one clear step at a time.',
    bullets: [
      'Dozens of complete grammar video lessons — already 25+, with new ones added every month',
      'A dedicated PDF for every single lesson — key takeaways, vocab, and example sentences',
      'A pre-made Anki flashcard deck for every lesson, ready to import — no manual card-making, ever',
      'Personal support: ask your questions directly, get real answers from a real teacher',
    ],
  },
  {
    label: 'Practise',
    title: 'Make It Yours',
    subtitle: 'A few minutes a day, and your French starts moving on its own.',
    bullets: [
      'A brand-new Daily Immersion: audio + text + instant comprehension quiz',
      'A dedicated PDF for every immersion (vocabulary + sentence breakdown)',
      'A pre-made Anki deck for every immersion — vocabulary that sticks, without extra work',
      'New content added every week, from A1 through B1/B2',
    ],
  },
  {
    label: 'Share',
    title: 'Grow Together',
    subtitle: 'French is a language you speak with people — not alone in front of a screen.',
    bullets: [
      'A private community of learners: share your progress, ask anything, celebrate wins together',
      'One live session per level, every week, up to B2 — reading circles, storytelling, live discussions',
      'Practice real spoken French, every week, with real people',
    ],
  },
] as const;
---

<section class="mx-auto max-w-[1180px] px-6 pb-28 md:px-12">
  <SectionHeader eyebrow="Included" headingLight="What" headingBold="you get" />

  <!-- Phones and tablets: the three cards simply follow one another, no switcher -->
  <div class="flex flex-col gap-12 lg:hidden">
    {steps.map(step => (
      <div data-reveal class="flex flex-col items-start gap-4">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-accent">{step.label}</p>
        <h3 class="font-display text-2xl font-bold tracking-[-0.02em] text-title md:text-[28px]">{step.title}</h3>
        <p class="text-[15px] italic leading-[1.5] text-muted">{step.subtitle}</p>
        <ul class="feature-visual-list">
          {step.bullets.map(bullet => <li>{bullet}</li>)}
        </ul>
      </div>
    ))}
  </div>

  <!-- Desktop (lg+): the interactive switcher -->
  <div
    class="feature-steps hidden items-center gap-14 lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"
    data-feature-steps
  >

    <!-- Steps — all shown at once; the active one is highlighted, the rest are greyed out (40%) -->
    <div data-reveal class="order-2 lg:order-1">
      <div class="feature-list flex flex-col gap-6" data-track aria-label="What you get — steps">
        {steps.map((step, i) => (
          <button
            type="button"
            aria-pressed={i === 0}
            class="feature-step text-left"
            data-step={i}
          >
            <span class="feature-step-label mb-2 block font-mono text-[11px] font-medium uppercase tracking-[0.14em]">{step.label}</span>
            <span class="feature-step-title block font-display text-2xl font-bold tracking-[-0.02em] md:text-[28px]">{step.title}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Visual (60%) — decorative, shows the active step's description; on mobile it sits above the list -->
    <div data-reveal class="order-1 lg:order-2" aria-hidden="true">
      <!-- Panels are stacked in one grid cell, so the card grows to fit the longest one -->
      <div class="feature-visual grid min-h-[300px] rounded-card lg:min-h-[420px]">
        {steps.map((step, i) => (
          <div
            class="feature-visual-panel flex flex-col items-start justify-center gap-4 py-8 md:py-10 lg:pl-4"
            class:list={[{ 'is-active': i === 0 }]}
            data-panel={i}
          >
            <p class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-accent">{step.label}</p>
            <h3 class="font-display text-2xl font-bold tracking-[-0.02em] text-title md:text-[28px]">{step.title}</h3>
            <p class="max-w-[600px] text-[15px] italic leading-[1.5] text-muted">{step.subtitle}</p>
            <ul class="feature-visual-list max-w-[600px]">
              {step.bullets.map(bullet => <li>{bullet}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .feature-step {
    cursor: pointer;
    background: none;
    opacity: 0.55;
    transition: opacity 200ms ease;
  }
  .feature-step[aria-pressed='true'] {
    opacity: 1;
  }

  /* Inactive: muted. Active: title takes --color-title, label stays accent. */
  .feature-step-label,
  .feature-step-title {
    color: var(--color-muted);
    transition: color 200ms ease;
  }
  .feature-step[aria-pressed='true'] .feature-step-label {
    color: var(--color-accent);
  }
  .feature-step[aria-pressed='true'] .feature-step-title {
    color: var(--color-title);
  }

  /* Transition: the outgoing panel fades out; the incoming one fades in while its
     lines slide up into place one after another (staggered). */
  .feature-visual-panel {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 240ms ease;
    pointer-events: none;
  }
  .feature-visual-panel.is-active {
    opacity: 1;
    transition-delay: 120ms;
  }
  .feature-visual-panel > *,
  .feature-visual-list li {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 420ms ease,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .feature-visual-panel.is-active > *,
  .feature-visual-panel.is-active .feature-visual-list li {
    opacity: 1;
    transform: none;
  }
  .feature-visual-panel.is-active > :nth-child(1) { transition-delay: 120ms; }
  .feature-visual-panel.is-active > :nth-child(2) { transition-delay: 170ms; }
  .feature-visual-panel.is-active > :nth-child(3) { transition-delay: 220ms; }
  .feature-visual-panel.is-active > :nth-child(4) { transition-delay: 260ms; }
  .feature-visual-panel.is-active .feature-visual-list li:nth-child(1) { transition-delay: 280ms; }
  .feature-visual-panel.is-active .feature-visual-list li:nth-child(2) { transition-delay: 330ms; }
  .feature-visual-panel.is-active .feature-visual-list li:nth-child(3) { transition-delay: 380ms; }
  .feature-visual-panel.is-active .feature-visual-list li:nth-child(4) { transition-delay: 430ms; }

  .feature-visual-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
  }
  .feature-visual-list li {
    position: relative;
    padding-left: 20px;
    text-align: left;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-body);
  }
  .feature-visual-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-visual-panel,
    .feature-visual-panel > *,
    .feature-visual-list li {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Feature switcher: all cards shown at once, active one highlighted. Cards are switched by
  // click, or by scrolling (wheel) which steps through them one at a time; scrolling past the
  // first/last card falls through to the page's section magnet (see SectionDots.astro).
  document.querySelectorAll<HTMLElement>('[data-feature-steps]').forEach(root => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.feature-step'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.feature-visual-panel'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!tabs.length) return;

    let active = 0;

    const render = () => {
      tabs.forEach((tab, i) => tab.setAttribute('aria-pressed', String(i === active)));
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === active));
    };

    function goTo(i: number) {
      active = (i + tabs.length) % tabs.length;
      render();
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => goTo(i)));

    // ── One wheel notch = one card. Stepping through the cards consumes the event; once
    //    you're past the first/last card, let it bubble up to the page-level section magnet
    //    (see SectionDots.astro) so the page moves to the previous/next block instead. ──
    let wheelLock = 0;
    root.addEventListener(
      'wheel',
      e => {
        if (reduceMotion || e.ctrlKey) return;
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
        const now = performance.now();
        if (now < wheelLock) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const dir = Math.sign(e.deltaY);
        if (dir === 0) return;
        const atEdge = (dir > 0 && active === tabs.length - 1) || (dir < 0 && active === 0);
        if (atEdge) return; // hand off to the page-level magnet

        e.preventDefault();
        e.stopPropagation();
        wheelLock = now + 550;
        goTo(active + dir);
      },
      { passive: false },
    );

    render();
  });
</script>
