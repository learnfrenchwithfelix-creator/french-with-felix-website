---
import SectionHeader from '../ui/SectionHeader.astro';

// "What you get": 3 steps, each written ONCE in the HTML (no mobile/desktop duplicates).
// - Below lg: the steps simply follow one another (heading, then subtitle + bullets).
// - lg and up: a CSS grid turns the same markup into a switcher. The step headings stack in the
//   left column (active one highlighted, the rest greyed out) and the active step's body shows on
//   the right, with a staggered crossfade on plain CSS transitions. Steps switch on click, or on
//   wheel scroll one notch at a time; scrolling past the first/last step falls through to the
//   page-level section magnet (see SectionDots.astro).
const steps = [
  {
    label: 'Learn',
    title: 'Build Your Foundation',
    subtitle: 'Master real French grammar, one clear step at a time.',
    bullets: [
      'Dozens of complete grammar video lessons — already 25+, with new ones added every month',
      'A dedicated PDF for every single lesson — key takeaways, vocab, and example sentences',
      'A pre-made Anki flashcard deck for every lesson, ready to import in seconds. No card-making: Anki schedules your reviews so the vocabulary sticks long-term',
      'Personal support: ask your questions directly and get real answers from me, usually within 24 hours',
    ],
  },
  {
    label: 'Practise',
    title: 'Make It Yours',
    subtitle: 'A few minutes a day, and your French starts moving on its own.',
    bullets: [
      'A brand-new Daily Immersion: audio + text + instant comprehension quiz',
      'A dedicated PDF for every immersion (vocabulary + sentence breakdown)',
      'A pre-made Anki deck for every immersion — vocabulary that sticks, without extra work',
      'New content added every week, from A1 through B1/B2',
    ],
  },
  {
    label: 'Share',
    title: 'Grow Together',
    subtitle: 'French is a language you speak with people — not alone in front of a screen.',
    bullets: [
      'A private community of learners: share your progress, ask anything, celebrate wins together',
      'One live session per level, every week, up to B2 — reading circles, storytelling, live discussions',
      'Practice real spoken French, every week, with real people',
    ],
  },
] as const;
---

<section class="mx-auto max-w-[1180px] px-6 pb-28 md:px-12">
  <SectionHeader eyebrow="Included" headingLight="What" headingBold="you get" />

  <div class="feature-steps" data-feature-steps>
    {steps.map((step, i) => (
      <div class="feature-step" class:list={[{ 'is-active': i === 0 }]} data-step={i}>
        <h3 data-reveal class="feature-step-head">
          <button type="button" class="feature-step-btn" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`wyg-step-${i}`}>
            <span class="feature-step-label mb-2 block font-mono text-[11px] font-medium uppercase tracking-[0.14em]">{step.label}</span>
            <span class="feature-step-title block font-display text-2xl font-bold tracking-[-0.02em] md:text-[28px]">{step.title}</span>
          </button>
        </h3>
        <div data-reveal class="feature-step-body" id={`wyg-step-${i}`}>
          <p class="max-w-[600px] text-[15px] italic leading-[1.5] text-muted">{step.subtitle}</p>
          <ul class="feature-list max-w-[600px]">
            {step.bullets.map(bullet => <li>{bullet}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* ── Shared ── */
  .feature-step-btn {
    background: none;
    text-align: left;
    cursor: default;
  }
  .feature-step-label {
    color: var(--color-accent);
  }
  .feature-step-title {
    color: var(--color-title);
  }
  .feature-step-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
  }
  .feature-list li {
    position: relative;
    padding-left: 20px;
    text-align: left;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-body);
  }
  .feature-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-accent);
  }

  /* ── Phones and tablets: steps follow one another ── */
  @media (max-width: 1023.98px) {
    .feature-steps {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
    .feature-step-btn {
      pointer-events: none; /* a plain heading here: nothing to switch */
    }
    .feature-step-body {
      margin-top: 1rem;
    }
  }

  /* ── Desktop: the same markup laid out as a switcher ── */
  @media (min-width: 1024px) {
    /* Headings in rows 2–4 of the left column; the 1fr rows around them keep the three
       headings together, vertically centred, however tall the right-hand body is. */
    .feature-steps {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: 1fr auto auto auto 1fr;
      column-gap: 3.5rem;
      row-gap: 1.5rem;
      min-height: 420px;
    }
    .feature-step {
      display: contents;
    }
    .feature-step-head {
      grid-column: 1;
    }
    .feature-step:nth-child(1) .feature-step-head { grid-row: 2; }
    .feature-step:nth-child(2) .feature-step-head { grid-row: 3; }
    .feature-step:nth-child(3) .feature-step-head { grid-row: 4; }

    .feature-step-btn {
      cursor: pointer;
      opacity: 0.55;
      transition: opacity 200ms ease;
    }
    .feature-step-label,
    .feature-step-title {
      color: var(--color-muted);
      transition: color 200ms ease;
    }
    .feature-step.is-active .feature-step-btn { opacity: 1; }
    .feature-step.is-active .feature-step-label { color: var(--color-accent); }
    .feature-step.is-active .feature-step-title { color: var(--color-title); }

    /* Bodies share the whole right column; only the active one is visible */
    .feature-step-body {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
      justify-content: center;
      padding: 2.5rem 0 2.5rem 1rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 240ms ease;
    }
    .feature-step.is-active .feature-step-body {
      opacity: 1;
      pointer-events: auto;
      transition-delay: 120ms;
    }

    /* The incoming body's lines slide up one after another (staggered) */
    .feature-step-body > *,
    .feature-step-body li {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 420ms ease,
        transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .feature-step.is-active .feature-step-body > *,
    .feature-step.is-active .feature-step-body li {
      opacity: 1;
      transform: none;
    }
    .feature-step.is-active .feature-step-body > :nth-child(1) { transition-delay: 120ms; }
    .feature-step.is-active .feature-step-body > :nth-child(2) { transition-delay: 170ms; }
    .feature-step.is-active .feature-step-body li:nth-child(1) { transition-delay: 240ms; }
    .feature-step.is-active .feature-step-body li:nth-child(2) { transition-delay: 290ms; }
    .feature-step.is-active .feature-step-body li:nth-child(3) { transition-delay: 340ms; }
    .feature-step.is-active .feature-step-body li:nth-child(4) { transition-delay: 390ms; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-step-body,
    .feature-step-body > *,
    .feature-step-body li {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-feature-steps]').forEach(root => {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.feature-step'));
    const buttons = steps.map(step => step.querySelector<HTMLButtonElement>('.feature-step-btn')!);
    const desktop = window.matchMedia('(min-width: 1024px)'); // the switcher layout (see styles)
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!steps.length) return;

    let active = 0;

    const render = () => {
      steps.forEach((step, i) => step.classList.toggle('is-active', i === active));
      buttons.forEach((btn, i) => btn.setAttribute('aria-pressed', String(i === active)));
    };

    function goTo(i: number) {
      active = (i + steps.length) % steps.length;
      render();
    }

    buttons.forEach((btn, i) => btn.addEventListener('click', () => { if (desktop.matches) goTo(i); }));

    // ── One wheel notch = one step (desktop switcher only). Stepping through the steps consumes
    //    the event; once past the first/last step it bubbles up to the page-level section magnet
    //    (see SectionDots.astro) so the page moves to the previous/next block instead. ──
    let wheelLock = 0;
    root.addEventListener(
      'wheel',
      e => {
        if (!desktop.matches || reduceMotion || e.ctrlKey) return;
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
        const now = performance.now();
        if (now < wheelLock) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const dir = Math.sign(e.deltaY);
        if (dir === 0) return;
        const atEdge = (dir > 0 && active === steps.length - 1) || (dir < 0 && active === 0);
        if (atEdge) return; // hand off to the page-level magnet

        e.preventDefault();
        e.stopPropagation();
        wheelLock = now + 550;
        goTo(active + dir);
      },
      { passive: false },
    );

    render();
  });
</script>
