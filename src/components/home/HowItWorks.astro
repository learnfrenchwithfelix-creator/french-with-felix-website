---
import SectionHeader from '../ui/SectionHeader.astro';

const steps = [
  {
    number: '01',
    title: 'Start with structure',
    description:
      'Clear grammar lessons that give you the real toolkit — without overwhelming you. Just enough structure to build solid foundations, while you start using the language from day one.',
  },
  {
    number: '02',
    title: 'Cross the threshold',
    description:
      "The real threshold isn't learning more theory — it's immersing yourself in real French. That step can feel intimidating, so I guide you through it gradually, not all at once.",
  },
  {
    number: '03',
    title: 'Immerse and expand',
    description:
      'Natural French content, live sessions, book readings, interactive exercises — always matched to your level. Challenging enough to keep you progressing, accessible enough to keep you hooked.',
  },
];
---

<section class="mx-auto max-w-[1180px] px-6 pb-28 md:px-12">
  <SectionHeader eyebrow="How it works" headingLight="How Liminal French" headingBold="works" />

  <ol class="grid grid-cols-1 gap-10 md:grid-cols-3">
    {steps.map(step => (
      <li data-reveal class="text-center md:text-left">
        <span class="mb-4 block font-mono text-sm font-medium tracking-[0.1em] text-accent">{step.number}</span>
        <h3 class="mb-3 font-display text-[21px] font-bold tracking-[-0.02em] text-title">{step.title}</h3>
        <p class="text-base leading-[1.65] text-body">{step.description}</p>
      </li>
    ))}
  </ol>
</section>
