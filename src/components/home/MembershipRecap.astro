---
import Button from '../ui/Button.astro';

const items = [
  '25+ video lessons, growing every month',
  'Hundreds of dedicated PDFs — and growing every week',
  'Thousands of pre-made flashcards, ready to import into Anki',
  'Daily audio + text + quiz, from A1 to B1/B2',
  'A private community, always open',
  'A live session every week, for every level',
];
---

<section class="mx-auto max-w-[1180px] px-6 pb-20 pt-4 md:px-12">
  <div class="rounded-section bg-surface px-8 py-16 text-center md:px-16">
    <h2 data-reveal class="mb-10 font-display text-[34px] tracking-[-0.025em] text-title">
      <span style="font-weight: var(--weight-light)">Everything included in</span>
      {' '}
      <span style="font-weight: var(--weight-bold)">your membership</span>
    </h2>

    <ul class="mx-auto mb-10 grid max-w-[640px] grid-cols-1 gap-x-8 gap-y-4 text-left sm:grid-cols-2">
      {items.map(item => (
        <li data-reveal class="flex items-start gap-3 text-base leading-[1.5] text-body">
          <svg class="mt-1 h-4 w-4 shrink-0 text-accent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <div data-reveal>
      <Button href="/start/" class="justify-center px-8 py-[15px] text-base">Start Your Free Trial →</Button>
      <p class="mt-4 text-sm text-muted">7 days free. Cancel anytime.</p>
    </div>
  </div>
</section>
