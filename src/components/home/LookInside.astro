---
// "Look inside": a preview of real membership content, one tab per part (grammar, Daily Immersion,
// live sessions, community). Each tab shows a light sample (video thumbnail, flashcards, text
// excerpt, screenshot) and links to the full sample on /look-inside/. Content: src/data/look-inside.ts.
// Each panel is written once; without JS only the first one shows (the tabs need JS anyway).
import SectionHeader from '../ui/SectionHeader.astro';
import TodoBox from '../look-inside/TodoBox.astro';
import VideoFacade from '../look-inside/VideoFacade.astro';
import AnkiCards from '../look-inside/AnkiCards.astro';
import CommunityChat from '../look-inside/CommunityChat.astro';
import FileIcon from '../look-inside/FileIcon.astro';
import { grammarLesson, dailyImmersion, liveSession, membershipCounts } from '../../data/look-inside';

const tabs = [
  { id: 'grammar', label: 'Grammar' },
  { id: 'immersion', label: 'Daily Immersion' },
  { id: 'live', label: 'Live sessions' },
  { id: 'community', label: 'Community' },
];
const linkClass = 'mt-6 inline-flex items-center gap-1 font-display text-[15px] font-semibold text-accent hover:text-[var(--color-accent-dark)]';
---

<section class="mx-auto max-w-[1180px] px-6 pb-28 md:px-12">
  <SectionHeader eyebrow="Look inside" headingLight="See what's" headingBold="inside" />

  <div data-reveal role="tablist" aria-label="Membership content" class="mb-8 flex flex-wrap gap-2" data-look-tabs>
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`look-tab-${t.id}`}
        aria-controls={`look-panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="look-tab rounded-full border border-border px-4 py-2 text-[14px] font-medium text-title transition-colors"
      >
        {t.label}
      </button>
    ))}
  </div>

  <!-- Grammar -->
  <div role="tabpanel" id="look-panel-grammar" aria-labelledby="look-tab-grammar" class="look-panel">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
      <VideoFacade
        youtubeId={grammarLesson.videos[0].youtubeId}
        title={`Watch the full lesson: ${grammarLesson.title}`}
        href="/look-inside/#grammar"
        todo="Thumbnail of the passé composé lesson (grammarLesson.videos)"
      />
      <div>
        <h3 class="mb-3 font-display text-2xl font-bold tracking-[-0.02em] text-title">Grammar lessons</h3>
        <p class="mb-4 text-base leading-[1.65] text-body">
          <strong>Over {membershipCounts.grammarLessons} clear video lessons</strong>, one topic at a time: a course to understand the grammar, then an immersion
          to hear it in real French. Each one comes with its PDFs (key takeaways and vocabulary) and a ready-made Anki deck with audio.
          Here's one from the A2 course: <strong>{grammarLesson.title.toLowerCase()}</strong>.
        </p>
        <a href="/look-inside/#grammar" class={linkClass}>Watch the full lesson →</a>
      </div>
    </div>
    <p class="mb-4 mt-10 flex items-center gap-2.5 text-[15px] text-muted"><FileIcon type="anki" />Flashcards made with sentences from the lessons: you learn, you review, you memorize. Tap to flip, press Listen to hear them.</p>
    <AnkiCards cards={grammarLesson.ankiCards} todo="Cards from the passé composé deck" class="lg:grid-cols-4" />
  </div>

  <!-- Daily Immersion -->
  <div role="tabpanel" id="look-panel-immersion" aria-labelledby="look-tab-immersion" class="look-panel" hidden>
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
      {dailyImmersion.paragraphs.length ? (
        <blockquote lang="fr" class="rounded-card border border-border bg-bg p-6 text-[17px] leading-[1.75] text-body md:p-8">
          {dailyImmersion.paragraphs[0]}
        </blockquote>
      ) : (
        <TodoBox label="First paragraph of the sample Daily Immersion (dailyImmersion.paragraphs)" />
      )}
      <div>
        <h3 class="mb-3 font-display text-2xl font-bold tracking-[-0.02em] text-title">Daily Immersion</h3>
        <p class="mb-4 text-base leading-[1.65] text-body">
          A short text in French every day, <strong>over {membershipCounts.immersionTexts} texts</strong> in all, with its audio, a comprehension quiz, a PDF and an Anki deck.
          Read one and take its quiz.
        </p>
        <a href="/look-inside/#daily-immersion" class={linkClass}>Read it and take the quiz →</a>
      </div>
    </div>
  </div>

  <!-- Live sessions -->
  <div role="tabpanel" id="look-panel-live" aria-labelledby="look-tab-live" class="look-panel" hidden>
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
      <VideoFacade
        youtubeId={liveSession.youtubeId}
        title="Watch an excerpt of a live session"
        href="/look-inside/#live-sessions"
        todo="Thumbnail of a live session excerpt (liveSession.youtubeId)"
      />
      <div>
        <h3 class="mb-3 font-display text-2xl font-bold tracking-[-0.02em] text-title">Live sessions</h3>
        <p class="mb-4 text-base leading-[1.65] text-body">
          <strong>{membershipCounts.livesPerWeek} live sessions every week</strong>, up to B2: reading circles, storytelling and real
          conversations with other learners.
        </p>
        <a href="/look-inside/#live-sessions" class={linkClass}>Watch an excerpt →</a>
      </div>
    </div>
  </div>

  <!-- Community -->
  <div role="tabpanel" id="look-panel-community" aria-labelledby="look-tab-community" class="look-panel" hidden>
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
      <CommunityChat />
      <div>
        <h3 class="mb-3 font-display text-2xl font-bold tracking-[-0.02em] text-title">The community</h3>
        <p class="mb-4 text-base leading-[1.65] text-body">
          A private space where members share their daily wins, ask questions and keep each other going.
        </p>
        <a href="/look-inside/#community" class={linkClass}>Take a peek →</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-look-tabs]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      // Arrow keys move between tabs (WAI-ARIA tabs pattern)
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });
</script>

<style>
  .look-tab:hover {
    border-color: var(--color-title);
  }
  .look-tab[aria-selected='true'] {
    background: var(--color-title);
    border-color: var(--color-title);
    color: var(--color-bg);
  }
</style>
