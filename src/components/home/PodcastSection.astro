---
import EpisodeCard from '../podcast/EpisodeCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { fetchEpisodes } from '../../utils/episodes';

const allEpisodes = await fetchEpisodes();
const latest = allEpisodes.slice(0, 3);

const spotifyShowUrl = import.meta.env.SPOTIFY_SHOW_ID
  ? `https://open.spotify.com/show/${import.meta.env.SPOTIFY_SHOW_ID}`
  : 'https://open.spotify.com/show/';
---

<section class="mx-auto max-w-[1180px] px-6 pb-28 md:px-12">
  <div>

    <SectionHeader eyebrow="Podcast" headingLight="Already learning?" headingBold="Keep going — for free." gap="tight">
      <a href="/podcast/" class="whitespace-nowrap text-[15px] font-semibold text-accent">Browse all episodes →</a>
    </SectionHeader>
    <p data-reveal class="podcast-intro mb-9 max-w-[640px] text-base leading-[1.65] text-body">
      The French with Félix podcast is 90+ episodes of real, natural French — with full transcripts. Free on Spotify, Apple Podcasts, and here.
    </p>

    <!-- Episode grid -->
    <!-- Each card sits in a reveal wrapper so the reveal doesn't override the card's own hover-lift transition.
         Phones show only the latest episode; the other two appear from md up. -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-7">
      {latest.map((ep, i) => (
        <div data-reveal class:list={['grid', i > 0 && 'hidden md:grid']}>
          <EpisodeCard
            number={ep.episodeNumber}
            level={ep.level}
            title={ep.titleFr}
            titleLang={ep.titleLang}
            duration={ep.duration}
            wpm={ep.wpm}
            theme={ep.theme}
            href={`/podcast/${ep.slug}/`}
            youtubeId={ep.youtubeId}
          />
        </div>
      ))}
    </div>

    <!-- Spotify CTA -->
    <div data-reveal class="podcast-cta mt-10 text-center">
      <a
        href={spotifyShowUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="spotify-cta inline-flex items-center gap-2.5 rounded-button border border-border bg-bg px-6 py-3 text-[14px] font-semibold text-title transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color:#1DB954; flex-shrink:0">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
        </svg>
        Listen on Spotify →
      </a>
    </div>

  </div>
</section>

<style>
  /* Short screens (laptops): tighter spacing so the block fits one screen and keeps the section magnet */
  @media (min-width: 768px) and (max-height: 900px) {
    .podcast-intro {
      margin-bottom: 1.25rem;
    }
    .podcast-cta {
      margin-top: 1.5rem;
    }
  }

  .spotify-cta:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
