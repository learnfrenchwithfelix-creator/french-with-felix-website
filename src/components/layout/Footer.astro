---
const socialLinks = [
  { label: 'YouTube', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'TikTok', href: '#' },
  { label: 'Spotify', href: '#' },
];

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/library', label: 'Library' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-[1180px] flex-col gap-8 px-6 py-10 md:px-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between md:gap-10">
      <div class="md:shrink-0">
        <p class="font-display text-lg font-bold tracking-[0.04em] text-title">LIMINAL FRENCH</p>
        <p class="mt-1 text-sm text-muted md:whitespace-nowrap">French is a journey. Let's take it together.</p>
      </div>

      <!-- Two separate columns: site pages, then social networks -->
      <div class="grid grid-cols-2 gap-10 sm:gap-16 md:gap-20">
        <nav aria-label="Secondary">
          <p class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-accent">Menu</p>
          <ul class="flex flex-col gap-2.5 font-display text-sm text-body">
            {navLinks.map((link) => (
              <li><a href={link.href} class="transition-colors hover:text-accent">{link.label}</a></li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Social">
          <p class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-accent">Follow</p>
          <ul class="flex flex-col gap-2.5 font-display text-sm text-body">
            {socialLinks.map((social) => (
              <li><a href={social.href} class="transition-colors hover:text-accent">{social.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <p class="border-t border-border pt-6 font-mono text-xs font-medium text-muted">
      © {year} Liminal French — French with Félix. All rights reserved.
    </p>
  </div>
</footer>
