---
const socialLinks = [
  { label: 'YouTube', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'TikTok', href: '#' },
  { label: 'Spotify', href: '#' },
];

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/library', label: 'Library' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-[1180px] flex-col gap-6 px-6 py-6 md:flex-row md:items-start md:justify-between md:gap-10 md:px-12">
    <div class="md:shrink-0">
      <p class="font-display text-base font-bold tracking-[0.04em] text-title">LIMINAL FRENCH</p>
      <p class="mt-0.5 text-[13px] text-muted">French is a journey. Let's take it together.</p>
      <p class="mt-2 font-mono text-[11px] font-medium text-muted">
        © {year} Liminal French — French with Félix. All rights reserved.
      </p>
    </div>

    <!-- Two separate columns: site pages, then social networks -->
    <div class="grid grid-cols-2 gap-10 sm:gap-16">
      <nav aria-label="Secondary">
        <ul class="flex flex-col gap-1 font-display text-[13px] text-body">
          {navLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-accent">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Social">
        <ul class="flex flex-col gap-1 font-display text-[13px] text-body">
          {socialLinks.map((social) => (
            <li><a href={social.href} class="transition-colors hover:text-accent">{social.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
