---
import Button from '../ui/Button.astro';

const navLinks = [
  { href: '/blog/', label: 'Blog' },
  { href: '/podcast/', label: 'Podcast' },
  { href: '/library/', label: 'Library' },
  { href: '/about/', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-border">
  <div class="mx-auto flex max-w-[1180px] items-center justify-between px-6 py-5 lg:px-12">
    <a href="/" class="font-display text-[22px] font-bold tracking-[0.04em] text-title">LIMINAL FRENCH</a>

    <div class="flex items-center gap-4 md:gap-[34px]">
      <div class="hidden items-center gap-[34px] md:flex">
        <nav class="flex items-center gap-[34px]" aria-label="Primary">
          {navLinks.map((link) => (
            <a href={link.href} class="text-[15px] font-medium text-body transition-colors hover:text-accent">{link.label}</a>
          ))}
        </nav>
        <Button href="/start/" class="px-5 py-[9px] text-[15px]">Start Learning →</Button>
      </div>

      <!-- Light / dark toggle. The moon shows in light mode (switch to dark), the sun in dark mode. -->
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-border text-title transition-colors hover:border-accent hover:text-accent"
        aria-label="Switch to dark mode"
      >
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <!-- Burger (phones and small tablets): its three bars turn into a cross when the menu is open -->
      <button
        type="button"
        id="menu-toggle"
        class="menu-toggle flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-border text-title transition-colors hover:border-accent hover:text-accent md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu: unfolds under the header bar (grid rows 0fr → 1fr) -->
  <div id="mobile-menu" class="mobile-menu md:hidden" data-open="false" inert>
    <div class="mobile-menu-inner">
      <nav class="flex flex-col px-6 pb-6 pt-2" aria-label="Mobile">
        {navLinks.map((link) => (
          <a href={link.href} class="border-b border-border py-4 font-display text-[19px] font-semibold text-title transition-colors hover:text-accent">{link.label}</a>
        ))}
        <Button href="/start/" class="mt-6 justify-center px-5 py-[13px] text-base">Start Learning →</Button>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const label = () =>
    toggle?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  label();

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    label();
  });

  // ── Mobile menu ──
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setMenu = (open: boolean) => {
    if (!menuBtn || !menu) return;
    menu.dataset.open = String(open);
    menu.inert = !open; // closed links are skipped by Tab and screen readers
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  menuBtn?.addEventListener('click', () => setMenu(menu?.dataset.open !== 'true'));
  // Close on a link tap, on Escape, and when the window grows past the burger breakpoint
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && menu?.dataset.open === 'true') {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', e => {
    if (e.matches) setMenu(false);
  });
</script>

<style>
  header {
    background-color: color-mix(in srgb, var(--color-bg) 60%, transparent);
    backdrop-filter: saturate(1.2) blur(12px);
  }

  /* Both icons sit on top of each other; the outgoing one spins away and shrinks
     while the incoming one spins into place. */
  .theme-toggle {
    position: relative;
    overflow: hidden;
  }
  .icon-moon,
  .icon-sun {
    position: absolute;
    transition:
      transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 250ms ease;
  }
  .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
  :global([data-theme='dark']) .icon-sun {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='dark']) .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }

  /* Burger: three bars; the middle one fades and the outer two rotate into a cross */
  .menu-bars {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }
  .menu-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.8px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 200ms ease,
      top 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-bars span:nth-child(1) { top: 0; }
  .menu-bars span:nth-child(2) { top: 5px; }
  .menu-bars span:nth-child(3) { top: 10px; }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(1) { top: 5px; transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-bars span:nth-child(3) { top: 5px; transform: rotate(-45deg); }

  /* Mobile menu: grid rows 0fr → 1fr opens it to its natural height; the links fade and settle */
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mobile-menu[data-open='true'] {
    grid-template-rows: 1fr;
  }
  .mobile-menu-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 250ms ease,
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mobile-menu[data-open='true'] .mobile-menu-inner {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-moon,
    .icon-sun {
      transition: opacity 150ms ease;
    }
    .menu-bars span,
    .mobile-menu,
    .mobile-menu-inner {
      transition: none;
    }
  }
</style>
