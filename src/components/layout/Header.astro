---
import Button from '../ui/Button.astro';

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/library', label: 'Library' },
  { href: '/about', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-border">
  <div class="mx-auto flex max-w-[1180px] items-center justify-between px-6 py-5 lg:px-12">
    <a href="/" class="font-display text-[22px] font-bold tracking-[0.04em] text-title">LIMINAL FRENCH</a>

    <div class="flex items-center gap-4 md:gap-[34px]">
      <div class="hidden items-center gap-[34px] md:flex">
        <nav class="flex items-center gap-[34px]" aria-label="Primary">
          {navLinks.map((link) => (
            <a href={link.href} class="text-[15px] font-medium text-body transition-colors hover:text-accent">{link.label}</a>
          ))}
        </nav>
        <Button href="/start" class="px-5 py-[9px] text-[15px]">Start Learning →</Button>
      </div>

      <!-- Light / dark toggle. The moon shows in light mode (switch to dark), the sun in dark mode. -->
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-border text-title transition-colors hover:border-accent hover:text-accent"
        aria-label="Switch to dark mode"
      >
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const label = () =>
    toggle?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  label();

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    label();
  });
</script>

<style>
  header {
    background-color: color-mix(in srgb, var(--color-bg) 60%, transparent);
    backdrop-filter: saturate(1.2) blur(12px);
  }

  /* Both icons sit on top of each other; the outgoing one spins away and shrinks
     while the incoming one spins into place. */
  .theme-toggle {
    position: relative;
    overflow: hidden;
  }
  .icon-moon,
  .icon-sun {
    position: absolute;
    transition:
      transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 250ms ease;
  }
  .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
  :global([data-theme='dark']) .icon-sun {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='dark']) .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-moon,
    .icon-sun {
      transition: opacity 150ms ease;
    }
  }
</style>
