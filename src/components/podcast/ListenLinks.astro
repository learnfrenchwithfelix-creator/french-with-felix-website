---
// Spotify / Apple Podcasts / RSS buttons for the podcast. URLs come from src/config/site.ts;
// an episode page can pass its own Spotify and Apple episode URLs. A link whose URL is empty is
// not rendered (never a "#" link).
import { podcastRssUrl, social } from '../../config/site';

interface Props {
  /** 'lg' = "Listen everywhere" block on the listing; 'sm' = "Also on" card on an episode page */
  size?: 'lg' | 'sm';
  /** The episode's own Spotify page (falls back to the show) */
  spotifyUrl?: string | null;
  /** The episode's own Apple Podcasts page (falls back to the show) */
  appleUrl?: string | null;
  class?: string;
}

const { size = 'lg', spotifyUrl, appleUrl, class: className = '' } = Astro.props;
const lg = size === 'lg';

const links = [
  {
    label: 'Spotify',
    href: spotifyUrl || social.spotify,
    color: '#1DB954',
    path: 'M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z',
  },
  {
    label: lg ? 'Apple Podcasts' : 'Apple',
    href: appleUrl || social.applePodcasts,
    color: '#B150E2',
    path: 'M12 1a11 11 0 100 22A11 11 0 0012 1zm0 2a9 9 0 110 18A9 9 0 0112 3zm0 2a7 7 0 100 14A7 7 0 0012 5zm0 2a5 5 0 110 10A5 5 0 0112 7zm0 3a2 2 0 100 4 2 2 0 000-4zm0 5.5c1.1 0 2.1.3 2.95.82L16.5 20H7.5l1.55-3.68A5.5 5.5 0 0112 15.5z',
  },
  {
    label: lg ? 'RSS Feed' : 'RSS',
    href: podcastRssUrl,
    color: '#F26522',
    path: 'M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z',
  },
].filter(link => link.href);

const linkClass = lg
  ? 'gap-2.5 rounded-button px-6 py-3 text-[14px]'
  : 'gap-2 rounded-[10px] px-[14px] py-[9px] text-[13px]';
const iconSize = lg ? 18 : 15;
---

<div class:list={['flex flex-wrap', lg ? 'justify-center gap-4' : 'gap-2.5', className]}>
  {links.map(link => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={['platform-link inline-flex items-center border border-border bg-bg font-semibold text-title', linkClass]}
    >
      <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style={`color:${link.color}`}>
        <path d={link.path} />
      </svg>
      {link.label}
    </a>
  ))}
</div>

<style>
  .platform-link {
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .platform-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
