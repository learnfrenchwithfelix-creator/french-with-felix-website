---
// Small file-type icon (PDF or Anki deck) shown next to a file name. Decorative: the text says the type.
// The source PNGs are 96×96 (icon centred on a transparent square).
interface Props {
  type: 'pdf' | 'anki';
  size?: number;
  class?: string;
}

const { type, size = 24, class: className } = Astro.props;
---

<img src={`/images/icons/file-${type}.png`} alt="" width={size} height={size} class:list={['inline-block shrink-0', className]} />
