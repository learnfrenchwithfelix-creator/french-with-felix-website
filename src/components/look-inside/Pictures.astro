---
// Document excerpts (e.g. PDF pages) as cards: every picture is cut to the same frame from the top,
// fades out at the bottom (there's more below) and lifts slightly on hover. TODO box while there are none.
import type { Picture } from '../../data/look-inside';
import TodoBox from './TodoBox.astro';

interface Props {
  pictures: Picture[];
  todo: string;
  class?: string;
}

const { pictures, todo, class: className = '' } = Astro.props;
---

{pictures.length ? (
  <div class:list={['grid grid-cols-1 gap-5', pictures.length > 1 && 'sm:grid-cols-2', className]}>
    {pictures.map((p) => (
      <figure class="doc-card overflow-hidden rounded-card border border-border bg-surface">
        <div class="doc-frame relative overflow-hidden">
          <img
            src={p.src}
            alt={p.alt}
            width={p.width}
            height={p.height}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-top"
          />
        </div>
        {p.caption && (
          <figcaption class="flex items-center gap-2 border-t border-border px-4 py-3 text-[14px] font-semibold text-title">
            {p.caption}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
) : (
  <TodoBox label={todo} class={className} />
)}

<style>
  .doc-card {
    transition:
      transform 250ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 250ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 250ms;
  }
  .doc-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-title);
    box-shadow: 0 14px 32px -12px rgb(0 0 0 / 0.35);
  }
  /* Same frame for every excerpt, whatever its height */
  .doc-frame {
    aspect-ratio: 4 / 3;
  }
  .doc-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, rgb(240 240 239 / 0.95));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .doc-card,
    .doc-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
