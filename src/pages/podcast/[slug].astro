---
import PodcastLayout from '../../layouts/PodcastLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { platformHost, platformUrl, podcastName } from '../../config/site';
import EpisodeAbout from '../../components/podcast/EpisodeAbout.astro';
import ListenLinks from '../../components/podcast/ListenLinks.astro';
import { getCollection } from 'astro:content';
import { fetchEpisodes } from '../../utils/episodes';
import { parsePodcastCSV } from '../../utils/parsePodcastCSV';
import { parseSRT } from '../../utils/parseSRT';
import { isIndexableEpisode } from '../../utils/content';
import { breadcrumbs, episodeNodes } from '../../utils/schema';
import { cleanEpisodeTitle, episodeDescription, episodeSeoTitle } from '../../utils/episode-title.mjs';

export async function getStaticPaths() {
  const episodes = await fetchEpisodes();

  // Per-episode extras (src/content/podcast/<slug>.md). A file whose name matches no CSV slug is
  // almost always a typo, so it fails the build rather than being silently ignored.
  const extras = new Map((await getCollection('episodes')).map(e => [e.id, e.data]));
  const csvSlugs = new Set(parsePodcastCSV().map(ep => ep.slug));
  const orphans = [...extras.keys()].filter(id => !csvSlugs.has(id));
  if (orphans.length) {
    throw new Error(`src/content/podcast/: no episode with slug ${orphans.map(o => `"${o}"`).join(', ')} in the podcast CSV`);
  }

  // The listing is one client-paginated page now: keep the old /podcast/2 … /podcast/N URLs
  // alive by redirecting them to /podcast?page=N.
  const lastListingPage = Math.ceil(episodes.length / 12);
  const legacyPages = Array.from({ length: Math.max(0, lastListingPage - 1) }, (_, i) => ({
    params: { slug: String(i + 2) },
    props: { redirectTo: `/podcast/?page=${i + 2}` },
  }));

  const episodePaths = episodes.map(ep => ({
    params: { slug: ep.slug },
    props: {
      slug:          ep.slug,
      spotifyUrl:    ep.spotifyUrl,
      episodeNumber: ep.episodeNumber,
      titleFr:       ep.titleFr,
      level:         ep.level,
      theme:         ep.theme,
      speechRate:    ep.speechRate,
      wpm:           ep.wpm,
      wordCount:     ep.wordCount,
      duration:      ep.duration,
      youtubeId:     ep.youtubeId,
      titleLang:     ep.titleLang,
      publishDate:   ep.publishDate,
      transcript:    parseSRT(ep.slug),
      extras:        extras.get(ep.slug) ?? null,
    },
  }));

  return [...episodePaths, ...legacyPages];
}

interface Props {
  /** Set only on the legacy /podcast/2… paths, which just redirect to the listing */
  redirectTo?:   string;
  slug:          string;
  spotifyUrl:    string | null;
  episodeNumber: number;
  titleFr:       string;
  level:         'A1' | 'A2' | 'B1' | 'B2';
  theme:         string;
  speechRate:    string;
  wpm:           number;
  wordCount:     number;
  duration:      string;
  youtubeId:     string | null;
  titleLang:     'fr' | 'en';
  publishDate:   string | null;
  transcript:    { timecode: string; seconds: number; text: string }[];
  extras:        { summary_en?: string; key_vocab?: { fr: string; en: string }[]; seoTitle?: string; appleEpisodeUrl?: string } | null;
}

if (Astro.props.redirectTo) return Astro.redirect(Astro.props.redirectTo);

const {
  slug,
  spotifyUrl,
  episodeNumber,
  titleFr,
  level,
  theme,
  speechRate,
  wpm,
  wordCount,
  duration,
  youtubeId,
  titleLang,
  publishDate,
  transcript,
  extras,
} = Astro.props;

const indexable = isIndexableEpisode(extras);

const speechRateLabel: Record<string, string> = {
  lent: 'Slow',
  normal: 'Natural',
  rapide: 'Fast',
};

const speedLabel = wpm > 0 ? `${speechRateLabel[speechRate] ?? speechRate} · ${wpm} wpm` : (speechRateLabel[speechRate] ?? speechRate);

// <title> and meta description (the H1 below stays the YouTube title)
const seoInput = { title: titleFr, episodeNumber, level, duration, wpm };
const pageTitle = episodeSeoTitle(seoInput, extras?.seoTitle);
const pageDescription = episodeDescription(seoInput, extras?.summary_en, podcastName);

// schema.org: PodcastEpisode + its YouTube VideoObject (with the full transcript) + breadcrumbs
const path = `/podcast/${slug}/`;
const episodeName = cleanEpisodeTitle(titleFr, episodeNumber);
const schema = [
  ...episodeNodes({
    path,
    name: episodeName,
    description: pageDescription,
    episodeNumber,
    publishDate,
    duration,
    youtubeId,
    transcript: transcript.map(p => p.text).join('\n\n'),
  }),
  breadcrumbs([['Podcast', '/podcast/'], [episodeName, path]]),
];
---

<PodcastLayout title={pageTitle} description={pageDescription} {indexable} {schema}>
  <Reveal />

  <div class="mx-auto max-w-[1180px] px-6 pb-12 pt-12 lg:px-12">

    <!-- Breadcrumb -->
    <a
      href="/podcast/"
      data-print-hide
      class="mb-8 inline-flex items-center gap-1 font-mono text-[12px] font-medium uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent"
    >
      ← All episodes
    </a>

    <!-- Episode header -->
    <div data-reveal class="mb-10">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <span class="font-display text-2xl tracking-[-0.02em] text-accent" style="font-weight: var(--weight-light)">
          Ep {episodeNumber}
        </span>
        <Badge level={level} />
        <span class="rounded-full bg-surface px-[10px] py-[3px] font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted">
          {theme}
        </span>
      </div>
      <h1
        lang={titleLang}
        class="mb-6 font-display text-[28px] leading-[1.1] tracking-[-0.035em] text-title md:text-[38px]"
        style="font-weight: var(--weight-bold)"
      >
        {titleFr}
      </h1>

      <!-- Metadata row -->
      <div class="flex flex-wrap gap-x-8 gap-y-3 border-t border-border pt-5">
        <div>
          <p class="mb-1 font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-muted">Duration</p>
          <p class="font-display text-[15px] font-semibold text-title">{duration}</p>
        </div>
        <div>
          <p class="mb-1 font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-muted">Speed</p>
          <p class="font-display text-[15px] font-semibold text-title">{speedLabel}</p>
        </div>
        <div>
          <p class="mb-1 font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-muted">Transcript</p>
          <p class="font-display text-[15px] font-semibold text-title">{wordCount.toLocaleString()} words</p>
        </div>
      </div>
    </div>

    <EpisodeAbout summary={extras?.summary_en} vocab={extras?.key_vocab} />

    <!-- Two-column body -->
    <!--
      DOM order: right column (player) first → appears at top on mobile.
      CSS order utilities flip them to left/right on desktop.
    -->
    <div class="grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-2 lg:grid-cols-[3fr_2fr]">

      <!-- ── RIGHT COLUMN : player only (sticky) ── -->
      <div data-reveal class="order-first md:order-last" data-print-hide>
        <div class="lg:sticky" style="top: calc(var(--header-height) + 24px);">

          {youtubeId ? (
            <div class="overflow-hidden rounded-card" style="position: relative; padding-bottom: 56.25%; height: 0;">
              <iframe
                id="yt-player"
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
                src={`https://www.youtube.com/embed/${youtubeId}?enablejsapi=1&rel=0&modestbranding=1`}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                title={titleFr}
              ></iframe>
            </div>
          ) : (
            <div class="flex aspect-video w-full items-center justify-center rounded-card border border-border bg-surface">
              <p class="font-mono text-xs font-medium text-muted">No video available</p>
            </div>
          )}

          <!-- Also on -->
          <div class="mt-5 rounded-card border border-border bg-surface p-5">
            <p class="mb-3 font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-muted">Also on</p>
            <ListenLinks size="sm" spotifyUrl={spotifyUrl} appleUrl={extras?.appleEpisodeUrl} />
          </div>

        </div>
      </div>

      <!-- ── LEFT COLUMN : transcript with timecodes ── -->
      <div class="order-last md:order-first">
        <!-- Transcript header -->
        <div data-reveal class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-[14px] font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-accent">Transcript</p>
            <h2 class="font-display text-[clamp(1.75rem,3vw,2.25rem)] leading-[1.1] tracking-[-0.035em] text-title">
              <span style="font-weight: var(--weight-light)">Full</span>
              <span style="font-weight: var(--weight-bold)"> transcript</span>
            </h2>
          </div>
          {transcript.length > 0 && (
            <div class="flex gap-2.5" data-print-hide>
              <a
                href={`/podcast/${slug}/transcript.txt`}
                download={`liminal-french-ep-${episodeNumber}-transcript.txt`}
                class="tool-btn inline-flex items-center gap-2 rounded-[10px] border border-border bg-bg px-4 py-2.5 text-[13px] font-semibold text-title"
              >
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M8 2v8M4.5 7L8 10.5 11.5 7M2.5 13.5h11" />
                </svg>
                Download
              </a>
              <button
                type="button"
                id="print-transcript"
                class="tool-btn inline-flex cursor-pointer items-center gap-2 rounded-[10px] border border-border bg-bg px-4 py-2.5 text-[13px] font-semibold text-title"
              >
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4.5 6V2h7v4M4.5 11.5h-2v-5h11v5h-2M4.5 9.5h7v4.5h-7z" />
                </svg>
                Print
              </button>
            </div>
          )}
        </div>

        <!-- Each paragraph's reveal sits on an inner wrapper: .transcript-para gets inline opacity from the playback highlight -->
        {transcript.length > 0 ? (
          <div class="space-y-8" id="transcript-body">
            {transcript.map((para, idx) => (
              <div class="transcript-para" data-para-start={para.seconds}>
                <div data-reveal>
                <div class="mb-2 flex items-center gap-2">
                  <button
                    class="timecode-btn inline-flex min-h-[44px] items-center font-mono text-xs font-medium text-muted transition-colors"
                    data-seek={para.seconds}
                    aria-label={`Jump to ${para.timecode}`}
                  >
                    {para.timecode}
                  </button>
                  {idx === 0 && (
                    <button
                      class="timecode-btn inline-flex min-h-[44px] items-center font-mono text-xs font-medium text-muted opacity-50 transition-colors"
                      data-seek={para.seconds}
                      aria-label={`Jump to ${para.timecode}`}
                    >(click to jump to timestamp)</button>
                  )}
                </div>
                <p lang="fr" class="text-[17px] leading-[1.8] text-body [text-align:justify]">{para.text}</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-[17px] text-muted">Transcript not yet available for this episode.</p>
        )}
      </div>

    </div>
  </div>

  <!-- CTA -->
  <div data-print-hide>
  <CTABanner
    eyebrow="Ready for more?"
    headingLight="Take your French"
    headingBold="to the next level."
    body={`Access structured courses, live practice sessions, and a community that keeps you going — all at ${platformHost}.`}
    cta="Explore courses →"
    href={platformUrl}
  />
  </div>

</PodcastLayout>

<script>
  document.getElementById('print-transcript')?.addEventListener('click', () => window.print());
</script>

<script>
  // Attach to the pre-existing iframe (YT API won't override its dimensions)
  const ytIframe = document.getElementById('yt-player') as HTMLIFrameElement | null;
  if (ytIframe) {
    let player: any;
    let hlInterval: number | null = null;

    // Define callback BEFORE loading the API script
    (window as any).onYouTubeIframeAPIReady = function () {
      player = new (window as any).YT.Player('yt-player', {
        // No videoId/playerVars — the iframe src already has them
        events: {
          onStateChange(e: any) {
            if (e.data === 1 /* PLAYING */) {
              if (!hlInterval) hlInterval = window.setInterval(highlightActive, 500);
            } else {
              if (hlInterval !== null) {
                window.clearInterval(hlInterval);
                hlInterval = null;
              }
            }
          },
        },
      });
    };

    // Inject YouTube IFrame API
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);

      // ── Timecode clicks → seek + play ──
      document.querySelectorAll<HTMLElement>('[data-seek]').forEach(btn => {
        btn.addEventListener('click', () => {
          const secs = parseInt(btn.dataset.seek ?? '0', 10);
          player?.seekTo?.(secs, true);
          player?.playVideo?.();
          setActiveBtn(btn);
        });
      });

      // ── Auto-highlight paragraph matching current playback time ──
      function highlightActive() {
        if (!player?.getCurrentTime) return;
        const t: number = player.getCurrentTime();
        const paras = document.querySelectorAll<HTMLElement>('.transcript-para');
        let activeIdx = -1;
        paras.forEach((p, i) => {
          if (t >= parseInt(p.dataset.paraStart ?? '0', 10)) activeIdx = i;
        });
        paras.forEach((p, i) => {
          const active = i === activeIdx;
          p.style.opacity = active ? '1' : '0.4';
          p.style.transition = 'opacity 0.3s ease';
          p.querySelectorAll<HTMLElement>('[data-seek]').forEach(btn =>
            btn.classList.toggle('timecode-active', active)
          );
        });
      }

      function setActiveBtn(clicked: HTMLElement) {
        document.querySelectorAll<HTMLElement>('[data-seek]').forEach(b =>
          b.classList.remove('timecode-active')
        );
        clicked.classList.add('timecode-active');
      }

      window.addEventListener('beforeunload', () => {
        if (hlInterval !== null) window.clearInterval(hlInterval);
      });

      // ── Spacebar → toggle play/pause ──
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.code !== 'Space') return;
        const tag = (document.activeElement as HTMLElement | null)?.tagName.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        e.preventDefault();
        if (!player?.getPlayerState) return;
        if (player.getPlayerState() === 1 /* PLAYING */) {
          player.pauseVideo();
        } else {
          player.playVideo();
        }
      });
  }
</script>

<style>
  .timecode-btn:hover,
  .timecode-active {
    color: var(--color-accent);
  }

  .tool-btn {
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .tool-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

</style>

<style is:global>
  /* Print: episode title/number (the page header) and the transcript at 12pt — no site chrome, player or CTA */
  @media print {
    header,
    footer,
    [data-print-hide] {
      display: none !important;
    }
    body::before,
    body::after {
      display: none !important;
    }
    #transcript-body {
      font-size: 12pt;
    }
    #transcript-body p {
      font-size: 12pt !important;
      line-height: 1.6 !important;
    }
    .transcript-para {
      opacity: 1 !important;
      break-inside: avoid;
    }
  }
</style>
