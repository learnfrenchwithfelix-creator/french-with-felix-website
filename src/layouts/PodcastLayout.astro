---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  /** Enriched episodes (summary_en filled) are indexable; the others stay noindex, follow. */
  indexable?: boolean;
}

const { title, description, indexable = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {!indexable && <meta slot="head" name="robots" content="noindex, follow" />}
  <slot />
</BaseLayout>
