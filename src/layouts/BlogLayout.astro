---
import BaseLayout from './BaseLayout.astro';
import { articleNode, breadcrumbs, publicFileUrl } from '../utils/schema';

interface Props {
  title: string;       // raw article title — used for the JSON-LD headline
  pageTitle?: string;  // full <title> tag value (falls back to title)
  description?: string;
  /** The article's URL path, e.g. "/blog/some-article/" */
  path: string;
  publishDate: Date;
  dateModified?: Date;
  image?: string;
  lang?: string;
}

const { title, pageTitle, description, path, publishDate, dateModified, image, lang } = Astro.props;

// Only an image that really exists in public/ (a missing file would be a 404 in link previews)
const ogImage = publicFileUrl(image);
const datePublished = publishDate.toISOString();

const schema = [
  articleNode({ path, title, description, publishDate, updatedDate: dateModified, image, lang }),
  breadcrumbs([['Blog', '/blog/'], [title, path]]),
];
---

<BaseLayout title={pageTitle ?? title} description={description} {schema}>
  <Fragment slot="head">
    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle ?? title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Liminal French" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="article:published_time" content={datePublished} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </Fragment>
  <slot />
</BaseLayout>
