# Spotify API credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Your Spotify Show ID
# Find it in your show's Spotify URL: open.spotify.com/show/SHOW_ID
SPOTIFY_SHOW_ID=your_spotify_show_id_here

# YouTube video IDs are stored per-episode in src/data/liminal_podcast.csv (youtube_id column)
# How to find the ID: open the video on YouTube → the URL is youtube.com/watch?v=XXXXXXX
# The XXXXXXX part (11 characters) is the youtube_id to paste in the CSV
